{% extends 'base.html.twig' %}

{% set breadcrumbs = ['nav.login'] %}
{% set breadcrumbs_root = false %}

{% block title %}{{ t('login.title') }}{% endblock %}

{% block body %}

    <main class="login-shell">
        <section class="login-visual" aria-label="{{ t('login.hero_aria') }}">
            <div class="hero-copy">
                <span class="eyebrow">{{ t('login.hero_label') }}</span>
                <h1>{{ t('login.hero_title')|nl2br }}</h1>
                <p>{{ t('login.hero_text') }}</p>
            </div>
        </section>

        <section class="login-panel">
            <div class="login-card">
                <span class="eyebrow">{{ t('login.label') }}</span>
                <h2>{{ t('login.heading') }}</h2>
                <p class="login-intro">{{ t('login.intro') }}</p>

                {% if app.user %}
                    <div class="logged-in">
                        {{ t('login.logged_as', {user: app.user.userIdentifier}) }}
                        <a href="{{ logout_path() }}">{{ t('login.logout') }}</a>
                    </div>
                {% endif %}

                <form method="post">
                    <div class="field">
                        <label for="username">{{ t('login.email') }}</label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus>
                    </div>

                    <div class="field">
                        <label for="password">{{ t('login.password') }}</label>
                        <div class="input-wrap">
                            <input type="password" name="_password" id="password" autocomplete="current-password" required>
                            <button class="password-toggle" type="button" aria-label="{{ t('login.show_aria') }}" data-password-toggle>{{ t('login.show') }}</button>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <button class="submit-button" type="submit">
                        <span>{{ t('login.submit') }}</span>
                        <span aria-hidden="true">↗</span>
                    </button>
                </form>

                <div class="login-meta">
                    <span class="status-dot" aria-hidden="true"></span>
                    <span>{{ t('login.secure') }}</span>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
