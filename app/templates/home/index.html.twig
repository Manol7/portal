{% extends 'base.html.twig' %}

{% block title %}{{ t('home.title') }}{% endblock %}

{% block body %}

    <main class="portal-page">
        <section class="portal-content">
            <div class="portal-intro">
                <span class="portal-label">{{ t('home.label') }}</span>
                <h1>{{ t('home.heading')|nl2br }}</h1>
                <p>{{ t('home.text') }}</p>
            </div>


            <section class="portal-card portal-menu" aria-labelledby="portal-menu-title">
                <span class="portal-label">{{ t('home.center') }}</span>
                <strong id="portal-menu-title">{{ t('home.quick') }}</strong>
                <div class="portal-menu-list">
                    {% if is_granted('ROLE_ADMIN') %}
                        <a class="portal-menu-item" href="{{ path('app_admin') }}">
                            <span>{{ t('home.admin') }}</span>
                            <span aria-hidden="true">↗</span>
                        </a>
                    {% endif %}
                    <a class="portal-menu-item" href="{{ path('app_tasks') }}">
                        <span>{{ t('home.tasks') }}</span>
                        <span aria-hidden="true">↗</span>
                    </a>
                    <a class="portal-menu-item" href="{{ path('app_contact') }}">
                        <span>{{ t('home.contact') }}</span>
                        <span aria-hidden="true">↗</span>
                    </a>
                    <span class="portal-menu-item is-muted">
                        <span>{{ t('home.more') }}</span>
                        <span>{{ t('home.soon') }}</span>
                    </span>
                </div>
            </section>
        </section>

    </main>
{% endblock %}
