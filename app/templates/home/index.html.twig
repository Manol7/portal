<!doctype html>
<html lang="pl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Portal Kamila</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: #101827;
            color: #eef2ff;
            font-family: system-ui, sans-serif;
        }
        main {
            width: min(440px, calc(100% - 80px));
            padding: 32px;
            background: #1b263b;
            border: 1px solid #334155;
            border-radius: 16px;
        }
        h1 { margin-top: 0; }
        p { color: #b8c5d9; line-height: 1.6; }
        .status { color: #86efac; }
    </style>
</head>
<body>
    <main>
        <h1>Portal Kamila</h1>
        <p>Miejsce na moje projekty i narzędzia.</p>
        <p class="status">Środowisko działa poprawnie.</p>
    </main>
</body>
</html>
