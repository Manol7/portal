LOCAL_UID=1000
LOCAL_GID=1000

DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# Mailing. Lokalnie: COMPOSE_PROFILES=dev + smtp://mailpit:1025 (podgląd na http://localhost:8025).
# Produkcja: prawdziwy DSN, np. smtp://user:haslo@smtp.example.com:587
COMPOSE_PROFILES=
MAILER_DSN=null://null
MAILER_FROM=no-reply@example.com
CONTACT_RECIPIENT=contact@example.com